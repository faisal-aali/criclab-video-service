# criclab-video-service — workers only.
# Auth / SMTP / CORS live on criclab-web-backend, not here.

# Same cluster and database the website API writes jobs into.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=criclab

# Same folder as the web API. Empty = ~/.local/share/criclab
STORAGE_DIR=

# `local` = Ollama for coaching notes. `production` = Amazon Bedrock.
APP_ENV=local

# Fetch source clips and upload overlay + PDF.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# APP_ENV=local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# APP_ENV=production
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=qwen.qwen3-coder-30b-a3b-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
